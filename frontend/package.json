{
  "name": "insightlens-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "InsightLens 桌面客户端：Excel 上传建库 + 自然语言问数",
  "author": "huanghaiwei",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "runtime": "node scripts/prepare-runtime.mjs",
    "preelectron": "node scripts/prepare-runtime.mjs",
    "electron": "electron .",
    "predist": "node scripts/prepare-runtime.mjs && vite build",
    "dist": "node scripts/dist.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^35.0.0",
    "electron-builder": "^26.18.0",
    "vite": "^6.0.7",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "build": {
    "appId": "com.gdou.insightlens",
    "productName": "InsightLens",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "electronFuses": {
      "runAsNode": true
    },
    "files": [
      "electron/**",
      "package.json",
      "node_modules/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "huanghaiwei123",
        "repo": "InsightLens",
        "releaseType": "release"
      }
    ],
    "artifactName": "InsightLens-Setup-${version}.${ext}",
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime"
      },
      {
        "from": "../target/classes",
        "to": "backend/classes"
      },
      {
        "from": "../target/lib",
        "to": "backend/lib"
      },
      {
        "from": "../application-local.example.yaml",
        "to": "application-local.yaml"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
